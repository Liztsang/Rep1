            ))}
          </nav>
          <button onClick={() => setShowInfo(true)} className="grid h-10 w-10 place-items-center rounded-full bg-white text-slate-600 shadow-sm"><Info size={18}/></button>
        </div>
      </header>

      <main className="mx-auto max-w-6xl px-4 pb-28 pt-6 md:px-8 md:pt-10">
        <AnimatePresence mode="wait">
          {tab === "home" && (
            <motion.div key="home" initial={{opacity:0,y:10}} animate={{opacity:1,y:0}} exit={{opacity:0}} className="space-y-7">
              <section className="grid gap-5 lg:grid-cols-[1.35fr_.65fr]">
                <div className="relative overflow-hidden rounded-[2rem] bg-slate-950 p-7 text-white shadow-xl md:p-10">
                  <div className="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-emerald-500/25 blur-3xl" />
                  <div className="relative max-w-xl">
                    <Badge className="mb-5 rounded-full border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-emerald-300 hover:bg-emerald-400/10"><Sparkles size={13} className="mr-1"/>AI meal insights</Badge>
                    <h1 className="text-4xl font-black leading-[1.08] tracking-tight md:text-6xl">Know what's on your plate.</h1>
                    <p className="mt-4 max-w-lg text-base leading-7 text-slate-300 md:text-lg">Upload a meal photo to estimate calories, macros, vitamins and minerals in seconds.</p>
                    <Button onClick={() => setTab("scan")} className="mt-7 h-12 rounded-2xl bg-emerald-500 px-6 font-bold text-white hover:bg-emerald-400">Scan a meal <ChevronRight size={18}/></Button>
                  </div>
                </div>
                <Card className="rounded-[2rem] border-0 bg-white shadow-sm"><CardContent className="p-7">
                  <div className="flex items-start justify-between"><div><p className="text-sm font-semibold text-slate-400">TODAY</p><h2 className="mt-1 text-2xl font-black">Daily energy</h2></div><Flame className="text-orange-500"/></div>
