const historyItems = [
  { name: "Salmon grain bowl", time: "Today, 12:35 PM", kcal: 618, color: "from-orange-200 to-rose-100" },
  { name: "Oatmeal with berries", time: "Today, 8:10 AM", kcal: 386, color: "from-violet-200 to-blue-100" },
  { name: "Tofu noodle soup", time: "Yesterday, 7:18 PM", kcal: 471, color: "from-emerald-200 to-lime-100" },
];

function Ring({ value, size = 60, stroke = 6, color = "#10b981", children }) {
  const r = (size - stroke) / 2;
  const c = 2 * Math.PI * r;
  return (
    <div className="relative shrink-0" style={{ width: size, height: size }}>
      <svg width={size} height={size} className="-rotate-90">
        <circle cx={size/2} cy={size/2} r={r} fill="none" stroke="#eef2f0" strokeWidth={stroke} />
        <motion.circle cx={size/2} cy={size/2} r={r} fill="none" stroke={color} strokeWidth={stroke} strokeLinecap="round"
          initial={{ strokeDashoffset: c }} animate={{ strokeDashoffset: c * (1 - Math.min(value,100)/100) }}
          strokeDasharray={c} transition={{ duration: .8 }} />
      </svg>
      <div className="absolute inset-0 grid place-items-center">{children}</div>
    </div>
  );
}

function App() {
  const [tab, setTab] = useState("home");
  const [image, setImage] = useState(null);
  const [scanning, setScanning] = useState(false);
  const [result, setResult] = useState(null);
  const [query, setQuery] = useState("");
  const [showInfo, setShowInfo] = useState(false);
  const inputRef = useRef(null);

  const daily = { calories: 1548, calorieGoal: 2200, protein: 86, carbs: 142, fat: 51 };

  const filteredHistory = useMemo(() => historyItems.filter(x => x.name.toLowerCase().includes(query.toLowerCase())), [query]);

  function chooseFile(file) {
    if (!file) return;
    if (!file.type.startsWith("image/")) return;
    setImage(URL.createObjectURL(file));
    setResult(null);
    setTab("scan");
  }

  function scanMeal() {
    if (!image) return;
    setScanning(true);
    setResult(null);
    window.setTimeout(() => {
      setScanning(false);
      setResult(sampleResult);
    }, 2300);
  }

