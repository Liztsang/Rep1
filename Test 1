                    </div>
                    <div>
                      {!result ? <div className="grid h-full min-h-[420px] place-items-center rounded-[2rem] bg-white p-8 text-center shadow-sm"><div><Sparkles className="mx-auto text-emerald-400" size={38}/><h3 className="mt-4 text-xl font-black">Ready for analysis</h3><p className="mt-2 max-w-sm text-slate-400">We’ll identify likely foods and estimate calories, macros and key micronutrients.</p></div></div> : <ResultPanel result={result}/>} 
                    </div>
                  </div>
                )}
              </div>
            </motion.div>
          )}

          {tab === "history" && (
            <motion.div key="history" initial={{opacity:0,y:10}} animate={{opacity:1,y:0}} className="mx-auto max-w-4xl">
              <h1 className="text-4xl font-black">Meal history</h1><p className="mt-2 text-slate-500">Review and compare your previous scans.</p>
              <div className="relative mt-6"><Search className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400" size={18}/><Input value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search meals" className="h-13 rounded-2xl border-0 bg-white pl-11 shadow-sm"/></div>
              <div className="mt-5 space-y-3">{filteredHistory.map(item=><Card key={item.name} className="rounded-3xl border-0 bg-white shadow-sm"><CardContent className="flex items-center gap-4 p-4"><div className={`h-16 w-16 rounded-2xl bg-gradient-to-br ${item.color}`}/><div className="min-w-0 flex-1"><div className="truncate font-extrabold">{item.name}</div><div className="text-sm text-slate-400">{item.time}</div></div><div className="text-right"><div className="font-black">{item.kcal}</div><div className="text-xs text-slate-400">kcal</div></div><ChevronRight className="text-slate-300" size={18}/></CardContent></Card>)}</div>
            </motion.div>
