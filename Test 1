      <div className="mt-6 grid grid-cols-2 gap-3">{result.macros.map(m=><div key={m.name} className="rounded-2xl bg-slate-50 p-3"><div className="flex items-center justify-between text-xs"><span className="font-bold text-slate-500">{m.name}</span><span className="font-black">{m.value}{m.unit}</span></div><Progress value={m.value/m.target*100} className="mt-2 h-1.5"/></div>)}</div>
    </CardContent></Card>
    <Card className="rounded-[2rem] border-0 bg-white shadow-sm"><CardContent className="p-6"><h3 className="font-black">Foods detected</h3><div className="mt-3 divide-y">{result.foods.map(f=><div key={f.name} className="flex items-center py-3 text-sm"><span className="flex-1 font-semibold">{f.name}</span><span className="mr-4 text-slate-400">{f.amount}</span><span className="font-bold">{f.kcal} kcal</span></div>)}</div></CardContent></Card>
    <Card className="rounded-[2rem] border-0 bg-white shadow-sm"><CardContent className="p-6"><div className="flex justify-between"><h3 className="font-black">Micronutrients</h3><span className="text-xs font-bold text-slate-400">% DAILY VALUE</span></div><div className="mt-4 grid grid-cols-2 gap-x-5 gap-y-4">{result.micros.map(m=><div key={m.name}><div className="flex justify-between text-xs"><span className="font-semibold">{m.name}</span><span className="font-black">{m.value}%</span></div><Progress value={m.value} className="mt-1.5 h-1.5"/></div>)}</div></CardContent></Card>
    <Button variant="outline" className="h-12 w-full rounded-2xl border-slate-200 bg-white"><RotateCcw size={16} className="mr-2"/>Edit foods or portions</Button>
  </motion.div>
}

export default App;
