                  <div className="mt-7 grid grid-cols-3 gap-3">{[["Protein","86 g"],["Carbs","142 g"],["Fat","51 g"]].map(x=><div key={x[0]} className="rounded-2xl bg-slate-50 p-3"><div className="text-xs text-slate-400">{x[0]}</div><div className="mt-1 font-extrabold">{x[1]}</div></div>)}</div>
                </CardContent></Card>
              </section>

              <section>
                <div className="mb-4 flex items-end justify-between"><div><p className="text-sm font-bold text-emerald-600">NUTRIENT CHECK</p><h2 className="text-2xl font-black">Your micronutrients</h2></div><button className="text-sm font-bold text-slate-500">View all</button></div>
                <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{sampleResult.micros.slice(0,4).map((m,i)=><Card key={m.name} className="rounded-3xl border-0 bg-white shadow-sm"><CardContent className="flex items-center gap-4 p-5"><Ring value={m.value} color={["#10b981","#f59e0b","#8b5cf6","#06b6d4"][i]}><span className="text-xs font-black">{m.value}%</span></Ring><div><div className="font-extrabold">{m.name}</div><div className="text-sm text-slate-400">{m.amount}</div></div></CardContent></Card>)}</div>
              </section>
            </motion.div>
