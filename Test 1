    { name: "Fibre", value: 7, unit: "g", target: 30, color: "bg-cyan-500", icon: Leaf },
  ],
  foods: [
    { name: "Roasted chicken", amount: "140 g", kcal: 258 },
    { name: "Steamed rice", amount: "180 g", kcal: 234 },
    { name: "Mixed vegetables", amount: "100 g", kcal: 50 },
  ],
  micros: [
    { name: "Vitamin A", value: 58, amount: "520 mcg" },
    { name: "Vitamin C", value: 71, amount: "64 mg" },
    { name: "Vitamin D", value: 18, amount: "3.6 mcg" },
    { name: "Vitamin B12", value: 76, amount: "1.8 mcg" },
